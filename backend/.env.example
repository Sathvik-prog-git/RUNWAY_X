# Copy this file to backend/.env and fill it in. NEVER commit backend/.env (it is git-ignored).

# REQUIRED. At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# SQLite file for local development (relative paths are inside the backend folder).
DATABASE_PATH=runway_dev.db

# Browser origins allowed to call the API with cookies (comma-separated, no trailing slash, no wildcard).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to true when the site is served over HTTPS (required for any https:// origin).
COOKIE_SECURE=false
# lax or strict
COOKIE_SAMESITE=lax

# Session lifetimes
SESSION_HOURS=12
SESSION_IDLE_MINUTES=120
REMEMBER_DAYS=30
REMEMBER_IDLE_DAYS=7

# Brute-force protection: failed attempts allowed per email+IP within the window
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
